# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore provider plugins
.terraform/providers/
.terraform/modules/

# Ignore backup files
*.bak
*.backup

# Ignore SSH keys
*.pem
*.pem.pub

# Ignore environment files
.env

# Ignore IDE specific files
.vscode/
.idea/
*.swp
*.swo

# Ignore logs
*.log

# Ignore terraform cache
.terraform/

# Ignore plan output files
*.tfplan

# Ignore terraform override files
*_override.tf
*_override.tf.json
